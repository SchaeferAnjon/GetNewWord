    "%@ 只有开和关，没有等级。默认关闭。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kennt nur Ein und Aus, keine Stufen. Standardmäßig aus."
          }
