    "现在不是从「应用程序」文件夹打开的：自动更新装不上，以后会一直停在这一版。拖进去再打开，或者点右边的按钮。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde nicht aus dem Ordner „Programme“ geöffnet: Updates lassen sich so nicht installieren, du bleibst bei dieser Version. Zieh sie dorthin und öffne sie neu, oder nimm die Taste rechts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It wasn't opened from the Applications folder, so updates can't be installed and you'd stay on this version. Drag it there and open it again, or use the button on the right."
          }
        }
      }
    },
