      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entwicklerversion verbindet sich nur mit dem Mitgliedschafts-Server, wenn die Umgebungsvariable GETNEWWORD_API auf einen lokalen Server zeigt. Bis dahin geht ein eigener Key."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
