            "state": "translated",
            "value": "Too many lookups in a row"
          }
        }
      }
    },
    "查的词会被存吗？": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert ihr, was ich nachschlage?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you keep the words I look up?"
          }
        }
      }
    },
    "查的词直接发给服务商，不经过我们": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abfragen gehen direkt an den Anbieter, nicht über uns"
